// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  ACTIVO
  FINALIZADO
}

enum GuestStatus {
  PENDIENTE
  AUSENTE
  PRESENTE
}

enum QrJobStatus {
  IDLE
  PROCESSING
  DONE
  ERROR
}

model User {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  contrasena String
  nombre     String
  events     Event[]

  createdAt DateTime @default(now())
}

model Event {
  id_evento            Int         @id @default(autoincrement())
  nombre               String
  fecha                DateTime
  locacion             String
  tipo                 String
  salon                String
  cant_invitados       Int
  coverImage           String?
  Estado               EventStatus @default(ACTIVO)
  porcentajeAsistencia Int         @default(0)

  // Relación con el creador
  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  // Relación con invitados
  guests Guest[]

  // Relación con media (videos)
  media EventMedia[]

  qrJobStatus            QrJobStatus @default(IDLE)
  qrGeneratedAt          DateTime?
  qrJobStartedAt         DateTime?
  qrJobFinishedAt        DateTime?
  qrJobError             String?
  qrJobTotal             Int?
  qrJobProcessed         Int?
  qrJobRequestedBy       Int?
  invitationBaseImageUrl String?
  invitationQrX          Int?
  invitationQrY          Int?
  invitationQrSize       Int?

  checkedInCount Int @default(0)

  createdAt DateTime @default(now())
}

model Guest {
  id                Int         @id @default(autoincrement())
  documento         String
  nombre            String
  apellido          String
  email             String?
  numero            String?
  mesa              String? // Para bodas/cenas
  status            GuestStatus @default(PENDIENTE)
  cant_acompanantes Int?
  invitacionEnviada Boolean     @default(false)
  video             String? //Url   
  foto              String? //Url

  qrImageUrl    String? // URL o path de la imagen generada (para uso futuro)
  qrGeneratedAt DateTime?

  // Para el Check-in
  qrHash      String // Código único que irá en el QR
  checkInTime DateTime?

  eventId Int
  event   Event @relation(fields: [eventId], references: [id_evento], onDelete: Cascade)

  @@unique([email, eventId]) // Un mismo mail no puede estar dos veces en el mismo evento
  @@unique([eventId, qrHash])
}

model EventMedia {
  id      Int   @id @default(autoincrement())
  eventId Int
  event   Event @relation(fields: [eventId], references: [id_evento], onDelete: Cascade)

  publicId String // Cloudinary public_id
  videoUrl String // Cloudinary URL
  nombre   String // Nombre amigable para identificar el video
  tipo     String // "individual" | "con_acompanantes" | "general"
  mesa     Int? // null = aplica a cualquier mesa
  formato  String? // "mp4", "webm", etc.
  duracion Int? // Duración en segundos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}
